# ---- Banco ----
POSTGRES_USER=verso
POSTGRES_PASSWORD=verso
POSTGRES_DB=verso
DATABASE_URL=postgresql+asyncpg://verso:verso@localhost:5432/verso

# ---- Fila ----
REDIS_URL=redis://localhost:6379/0
# Se a porta padrão já estiver ocupada na sua máquina, mude aqui e no REDIS_URL acima.
# REDIS_HOST_PORT=6380
# POSTGRES_HOST_PORT=5433

# ---- Storage ----
VERSO_STORAGE_DIR=./storage

# ---- Pipeline ----
# Qualidade acima de velocidade: large-v3 é o modelo mais preciso do faster-whisper.
# Alternativa rápida (~4x) com perda modesta: distil-large-v3
VERSO_WHISPER_MODEL=large-v3
# int8 no CPU do Mac; float16 se houver CUDA
VERSO_WHISPER_COMPUTE=int8
VERSO_WHISPER_DEVICE=cpu
# Demucs: mps no Apple Silicon, cuda em GPU NVIDIA, cpu como fallback
VERSO_DEMUCS_DEVICE=mps
VERSO_DEMUCS_MODEL=htdemucs
# Palavras abaixo deste valor chegam marcadas no editor
VERSO_LOW_CONFIDENCE=0.5
# Guardamos apenas o stem vocal; bateria/baixo/outros são descartados
VERSO_KEEP_VOCAL_STEM=true
VERSO_MAX_UPLOAD_MB=50

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
