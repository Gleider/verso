FROM python:3.12-slim

# ffmpeg é usado para ler duração e normalizar o áudio enviado.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock* ./
# Todos os membros do workspace precisam existir para o uv resolver, mesmo que
# apenas um deles seja instalado abaixo.
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker

# A API não carrega nada de ML: sobe em segundos.
RUN uv sync --frozen --no-dev --package verso-api

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000

CMD ["sh", "-c", "cd apps/api && alembic upgrade head && cd /app && uvicorn verso_api.main:app --host 0.0.0.0 --port 8000"]
